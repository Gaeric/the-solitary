# TheSolitary local configuration
#
# Copy this file to config.mk and edit the paths below to match your setup.
#   cp config.mk.example config.mk
#
# config.mk is gitignored; never commit your personal paths.
#
# --- Windows example ---
# STS2_DIR := D:/Program Files/Steam/steamapps/common/Slay the Spire 2
# STS2_DATA_DIR := $(STS2_DIR)/data_sts2_windows_x86_64
# GODOT_EXE := D:/Program Files/Godot_v4.5.1-stable_mono_win64/Godot_v4.5.1-stable_mono_win64.exe

# Path to the Slay the Spire 2 install directory (contains SlayTheSpire2.pck).
STS2_DIR := /home/zero/data/SteamLibrary/steamapps/common/Slay the Spire 2

# Path to the platform-specific data directory (contains sts2.dll and 0Harmony.dll).
#   Linux:   data_sts2_linuxbsd_x86_64
#   Windows: data_sts2_windows_x86_64
#   macOS:   data_sts2_macos_x86_64
# If left unset, the Makefile derives it from STS2_DIR and the host OS.
STS2_DATA_DIR := $(STS2_DIR)/data_sts2_linuxbsd_x86_64

# Path to the Godot 4.5.1 mono editor binary.
# This must point to a specific Godot version; do not rely on a system-wide godot.
GODOT_EXE := /path/to/godot
